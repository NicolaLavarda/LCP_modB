    "# the role of anisotropy $$a\\neq b$$\n",
    "plt.close()\n",
    "aa,bb = 1.0,5.0\n",
    "x, y = np.meshgrid(np.arange(-4.5, 4.5, 0.2), np.arange(-4.5, 4.5, 0.2))\n",
    "fig, (ax1, ax2) = plt.subplots(2,1, figsize=(10, 8))\n",
    "z=np.abs(minima_surface(x,y,aa,bb))\n",
    "for ax in (ax1, ax2):\n",
    "    ax.contour(x, y, z, levels=np.logspace(0.0, 5, 35), norm=LogNorm(), cmap=\"RdYlBu_r\")\n",
    "    ax.plot(0,0, 'r*', markersize=18)\n",
    "    ax.set_xlim((-4.5, 4.5))\n",
    "    ax.set_ylim((-4.5, 4.5))\n",
    "\n",
    "#initial point\n",
    "init1=[-2,4]\n",
    "init2=[-1.7,4]\n",
    "init3=[-1.5,4]\n",
    "init4=[-3,4.5]\n",
    "init5=[3,4.5]\n",
    "\n",
    "#initial learning rates\n",
    "#eta1=0.1\n",
    "#eta2=0.5\n",
