    "# Compare other methods gradient descent with momentum and NAG\n",
    "plt.close()\n",
    "a,b = 1.0,1.0\n",
    "x, y = np.meshgrid(np.arange(-4.5, 4.5, 0.2), np.arange(-4.5, 4.5, 0.2))\n",
    "fig, (ax1, ax2) = plt.subplots(2,1,figsize=(10, 6))\n",
    "z=np.abs(minima_surface(x,y,a,b))\n",
    "#ax.contour(x, y, z, levels=np.logspace(0.0, 5, 35), norm=LogNorm(), cmap=\"RdYlBu_r\")\n",
    "#ax.plot(0,0, 'r*', markersize=18)\n",
    "for ax in (ax1, ax2):\n",
    "    ax.contour(x, y, z, levels=np.logspace(0.0, 5, 35), norm=LogNorm(), cmap=\"RdYlBu_r\")\n",
    "    ax.plot(0,0, 'r*', markersize=18)\n",
    "    ax.set_xlim((-4.5, 4.5))\n",
    "    ax.set_ylim((-4.5, 4.5))\n",
    "\n",
    "\n",
    "#initial point\n",
    "init1=[-2,4]\n",
    "init2=[-1.7,4]\n",
    "init3=[-1.5,4]\n",
    "init4=[-3,4.5]\n",
    "init5=[3,4.5]\n",
    "\n",
    "#initial learning rates\n",
    "#eta1=0.1\n",
    "#eta2=0.5\n",
    "#eta3=1.0\n",
    "#eta4=1.01\n",
    "\n",
    "\n",
    "gdwm_1=gd_with_mom(grad_minima_surface,init1, n_epochs=70, eta=eta1,gamma=0.9)\n",
    "gdwm_2=gd_with_mom(grad_minima_surface,init2, n_epochs=70, eta=eta2,gamma=0.9)\n",
    "gdwm_3=gd_with_mom(grad_minima_surface,init3, n_epochs=70, eta=eta3,gamma=0.9)\n",
    "gdwm_4=gd_with_mom(grad_minima_surface,init4, n_epochs=70, eta=eta4,gamma=0.9)\n",
    "\n",
    "\n",
    "nag_1=NAG(grad_minima_surface,init1, n_epochs=70, eta=eta1, gamma=0.9)\n",
    "nag_2=NAG(grad_minima_surface,init2, n_epochs=70, eta=eta2, gamma=0.9)\n",
    "nag_3=NAG(grad_minima_surface,init3, n_epochs=70, eta=eta3, gamma=0.9)\n",
    "nag_4=NAG(grad_minima_surface,init4, n_epochs=70, eta=eta4, gamma=0.9)\n",
    "\n",
    "#print(gd_1)\n",
    "overlay_trajectory_contour(ax1,gdwm_1,'$\\eta=$%s'% eta1,'g--*', lw=0.5)\n",
    "overlay_trajectory_contour(ax1,gdwm_2,'$\\eta=$%s'% eta2,'b-<', lw=0.5)\n",
    "overlay_trajectory_contour(ax1,gdwm_3,'$\\eta=$%s'% eta3,'y->', lw=0.5)\n",
    "overlay_trajectory_contour(ax1,gdwm_4,'$\\eta=$%s'% eta4,'c-o', lw=0.5)\n",
    "\n",
    "\n",
    "overlay_trajectory_contour(ax2,nag_1,'$\\eta=$%s'% eta1,'g--*', lw=0.5)\n",
    "overlay_trajectory_contour(ax2,nag_2,'$\\eta=$%s'% eta2,'b-<', lw=0.5)\n",
    "overlay_trajectory_contour(ax2,nag_3,'$\\eta=$%s'% eta3,'y->', lw=0.5)\n",
    "overlay_trajectory_contour(ax2,nag_4,'$\\eta=$%s'% eta4,'c-o', lw=0.5)\n",
    "\n",
    "\n",
    "plt.legend(loc=2)\n",
    "plt.show()\n",
    "fig.savefig(\"gdwm_and_nag.pdf\", bbox_inches='tight')"
   ]
  },
