    "#eta4=1.01\n",
    "\n",
    "#test smaller choice for anisotropic case\n",
    "\n",
    "#define a new gd function for the anisotropic case\n",
    "gd_1_asym=gd_asym(grad_minima_surface,init1, n_epochs=100, eta=eta1,...,...)\n",
    "\n",
    "\n",
    "\n",
    "gdwm_1_asym=gd_with_mom_asym(grad_minima_surface,init1, n_epochs=100, eta=eta1,..., ..., gamma=0.9)\n",
