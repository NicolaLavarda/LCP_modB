    "\n",
    "\n",
    "overlay_trajectory_contour(ax2,...,'$\\eta=$%s'% eta1,'g--*', lw=0.5)\n",
    "\n",
    "\n",
    "plt.legend(loc=2)\n",
    "plt.show()\n",
    "fig.savefig(\"GD_GDWM_asym.pdf\", bbox_inches='tight')\n"
   ]
